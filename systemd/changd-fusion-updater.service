[Unit]
Description=Changd Fusion opt-in immutable GHCR updater
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/changd-fusion/updater.env
ExecStart=/usr/local/sbin/changd-fusion-updater-container
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/changd-fusion-updater /run /var/run
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
