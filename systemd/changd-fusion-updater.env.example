# Install as /etc/changd-fusion/updater.env with mode 0600.
FUSION_UPDATER_IMAGE=ghcr.io/mkaand/changd-fusion-updater@sha256:REPLACE_WITH_VERIFIED_DIGEST
FUSION_COMPOSE_PROJECT=changd-fusion-v030
FUSION_PROJECT_DIRECTORY=/opt/changd-fusion-v030
FUSION_COMPOSE_BASE_FILE=/opt/changd-fusion-v030/compose.yml
FUSION_COMPOSE_OVERRIDE_FILE=/opt/changd-fusion-updater/docker-compose.ghcr.yml
FUSION_COMPOSE_ENV_FILE=/opt/changd-fusion-v030/.env
FUSION_UI_HOST_PORT=3000
FUSION_UPDATER_STATE_DIRECTORY=/var/lib/changd-fusion-updater
FUSION_DOCKER_CONFIG_DIRECTORY=/etc/changd-fusion/docker
FUSION_TRUSTED_REPOSITORY=mkaand/changd-fusion
FUSION_UPDATER_DRY_RUN=1

# Optional read-only GitHub credential for Actions/GHCR evidence and attestations.
# FUSION_GITHUB_TOKEN=

# Optional Telegram Bot API notification transport. Set both or neither.
# FUSION_TELEGRAM_BOT_TOKEN=
# FUSION_TELEGRAM_CHAT_ID=
