NODE_ENV=development
DATABASE_URL=postgresql://changd_fusion:replace-me@127.0.0.1:5432/changd_fusion
JWT_SECRET=
CHANNEL_KEY=
PUBLIC_URL=http://localhost:3000
PORT=8000
REGISTRATION_ENABLED=false
DATA_DIR=./data/fusion
HISTORY_DAYS=90
CAPTURE_TIMEOUT_MS=30000
# Optional: use a compatible system Chromium instead of the bundled Playwright browser.
# PLAYWRIGHT_EXECUTABLE_PATH=/usr/bin/chromium

# Bounded captures: defaults are suitable for a small development host.
CHROMIUM_CONCURRENCY=1
MAX_CAPTURE_WIDTH=4096
MAX_CAPTURE_HEIGHT=8192
MAX_CAPTURE_PIXELS=8000000
