{
  "name": "changd-fusion-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "tsx src/worker-main.ts",
    "worker:prod": "node dist/worker-main.js",
    "migrate": "tsx src/migrate.ts",
    "create-admin": "tsx src/create-admin.ts",
    "reset-admin-password": "tsx src/reset-admin-password.ts",
    "test": "tsx --test --test-timeout=30000 test/*.test.ts",
    "test:integration": "node scripts/integration-runner.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "decimal.js": "10.6.0",
    "diff": "9.0.0",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
