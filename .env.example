# Copy locally to .env; never commit runtime configuration.
POSTGRES_DB=changd_fusion
POSTGRES_USER=changd_fusion
# Generate all three independently. No default credentials are shipped.
POSTGRES_PASSWORD=
JWT_SECRET=
# 32 random bytes, hex encoded; keep stable to decrypt stored notification credentials.
CHANNEL_KEY=
PUBLIC_URL=http://localhost:3000
REGISTRATION_ENABLED=false
HISTORY_DAYS=90

# Bounded captures: CAPTURE_TIMEOUT_MS is the legacy fallback only. New monitor defaults use 60 seconds and can select 30-90 seconds.
CHROMIUM_CONCURRENCY=1
PREVIEW_CAPACITY_WAIT_MS=15000
MAX_CAPTURE_WIDTH=4096
MAX_CAPTURE_HEIGHT=8192
MAX_CAPTURE_PIXELS=8000000
CAPTURE_TIMEOUT_MS=30000
# API previews launch rootless Chromium. Keep this budget separate from the worker.
API_CPUS=0.75
API_MEMORY=640m
API_PIDS=192
API_SHM=64mb
# Worker defaults retain the larger 1 GiB / 256 PID margin for scheduled capture.
WORKER_CPUS=1.0
WORKER_MEMORY=1g
WORKER_PIDS=256
WORKER_SHM=256mb
WORKER_STOP_GRACE=180s
