# Copy locally to .env; never commit runtime configuration.
POSTGRES_DB=changd_fusion
POSTGRES_USER=changd_fusion
# Generate all three independently. No default credentials are shipped.
POSTGRES_PASSWORD=
JWT_SECRET=
# 32 random bytes, hex encoded; keep stable to decrypt stored notification credentials.
CHANNEL_KEY=
PUBLIC_URL=http://localhost:3000
# Optional but required for password-reset delivery. This server-managed SMTP
# configuration is intentionally separate from editable notification channels.
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD= # set only in the deployment secret manager
RECOVERY_SMTP_FROM=
REGISTRATION_ENABLED=false
HISTORY_DAYS=90

# Bounded captures: defaults are suitable for a small development host.
CHROMIUM_CONCURRENCY=1
MAX_CAPTURE_WIDTH=4096
MAX_CAPTURE_HEIGHT=8192
MAX_CAPTURE_PIXELS=8000000
CAPTURE_TIMEOUT_MS=30000
WORKER_CPUS=1.0
WORKER_MEMORY=1g
WORKER_PIDS=256
WORKER_SHM=256mb
WORKER_STOP_GRACE=180s
