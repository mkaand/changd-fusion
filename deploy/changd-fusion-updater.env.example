# Root-owned (0600) configuration for the opt-in host updater.
FUSION_PROJECT_NAME=changd-fusion-simple
FUSION_PROJECT_DIR=/opt/changd-fusion
FUSION_COMPOSE_FILES=/opt/changd-fusion/docker-compose.yml:/opt/changd-fusion/docker-compose.ghcr.yml
FUSION_CONTRACT_FILE=/var/lib/changd-fusion-updater/runtime-contract.json
FUSION_STATE_DIR=/var/lib/changd-fusion-updater
FUSION_HEALTH_URL=http://127.0.0.1:8127/api/v1/health
FUSION_MIN_FREE_MB=2048

# Optional updater-only Telegram destination. Leave both unset for no alerts.
# FUSION_TELEGRAM_BOT_TOKEN=
# FUSION_TELEGRAM_CHAT_ID=
